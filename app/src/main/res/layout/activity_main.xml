<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:padding="20dp">

    <TextView
        android:id="@+id/mainHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Hybrid Hours"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/settingsButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_gear"
        android:padding="8dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:layout_constraintTop_toTopOf="@id/mainHeader"
        app:layout_constraintBottom_toBottomOf="@id/mainHeader"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/primary"
        android:contentDescription="Settings" />

    <TextView
        android:id="@+id/officeHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Work From Office Time"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/mainHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- INPUT BLOCK: START -->
    <LinearLayout
        android:id="@+id/inputBlock"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_card"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/officeHeader"
        app:layout_constraintBottom_toTopOf="@id/inputBlock1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1.2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Time"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:textColor="@color/textPrimary"/>

        <TimePicker
            android:id="@+id/startTimePicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:timePickerMode="spinner"/>
    </LinearLayout>

    <!-- INPUT BLOCK: END -->
    <LinearLayout
        android:id="@+id/inputBlock1"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/rounded_card"
        android:layout_marginTop="10dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        app:layout_constraintTop_toBottomOf="@id/inputBlock"
        app:layout_constraintBottom_toTopOf="@id/totalHours"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_weight="1.2">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="End Time"
            android:textStyle="bold"
            android:layout_marginTop="8dp"
            android:textColor="@color/textPrimary"/>

        <TimePicker
            android:id="@+id/endTimePicker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:timePickerMode="spinner"/>

    </LinearLayout>

    <TextView
        android:id="@+id/totalHours"
        android:text="Total Office Hours: --"
        android:textSize="16sp"
        android:textColor="@color/textSecondary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/inputBlock1"
        app:layout_constraintBottom_toTopOf="@id/wfhHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- OUTPUT BLOCK -->
    <TextView
        android:id="@+id/wfhHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WFH Required"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/textPrimary"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/totalHours"
        app:layout_constraintBottom_toTopOf="@id/wfhBeforeCard"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- BEFORE OFFICE CARD -->
    <LinearLayout
        android:id="@+id/wfhBeforeCard"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_card"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/wfhHeader"
        app:layout_constraintBottom_toTopOf="@id/wfhAfterCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/wfhBeforeText"
            android:text="Before Office: --"
            android:textSize="16sp"
            android:textColor="@color/textPrimary" />
    </LinearLayout>

    <!-- AFTER OFFICE CARD -->
    <LinearLayout
        android:id="@+id/wfhAfterCard"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_card"
        android:padding="14dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/wfhBeforeCard"
        app:layout_constraintBottom_toTopOf="@id/footerText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/wfhAfterText"
            android:text="After Office: --"
            android:textSize="16sp"
            android:textColor="@color/textPrimary" />
    </LinearLayout>

    <TextView
        android:id="@+id/footerText"
        android:text="Developed by Prince Chauhan"
        android:textSize="12sp"
        android:textColor="@color/textSecondary"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/wfhAfterCard"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
